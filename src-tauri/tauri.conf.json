{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniBox Desktop",
  "version": "0.1.1",
  "identifier": "dev.omnibox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniBox Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Virtual machines made simple",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["qemu-system-x86", "qemu-system-arm", "qemu-utils", "swtpm", "ovmf"] },
      "rpm": { "depends": ["qemu-system-x86-core", "qemu-img", "swtpm", "edk2-ovmf"] }
    }
  }
}
